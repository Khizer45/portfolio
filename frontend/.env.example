# Frontend configuration. For local development copy to `.env.local`:
#   Copy-Item .env.example .env.local      (PowerShell)
#   cp .env.example .env.local             (macOS/Linux)
# On Vercel, set these in Project → Settings → Environment Variables.

# Where the Next.js server reaches the FastAPI backend (no trailing slash).
# Used for server-side data fetching AND for the /api/v1 proxy used by the admin.
# Production example: https://portfolio-api.onrender.com
API_URL=http://localhost:8000

# Public URL of this site, for the sitemap and social previews. Optional on Vercel
# (the production URL is detected automatically).
# NEXT_PUBLIC_SITE_URL=https://khizer-hayat.vercel.app

# Leave unset. Only set if the browser must call the backend directly instead of
# through this site's /api/v1 proxy (requires cross-site cookies; see docs/DEPLOYMENT.md).
# NEXT_PUBLIC_API_URL=
