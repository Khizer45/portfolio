# Backend configuration. Copy to `.env` for local development:
#   copy .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# In production, set these as environment variables on your host instead of a file.
# Never commit a real .env file.

# development | test | production
ENVIRONMENT=development

# PostgreSQL connection. postgres:// and postgresql:// URLs are converted automatically.
# Neon example: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio

# Required in production (at least 32 random characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Browser origins allowed to call the API (comma-separated, no trailing slash).
# Production example: https://khizer-hayat.vercel.app
CORS_ORIGINS=http://localhost:3000

# Session cookie. Secure defaults to true in production; the name defaults to
# "__Host-portfolio_session" over HTTPS and "portfolio_session" otherwise.
# SESSION_COOKIE_SAMESITE=lax
# SESSION_TTL_HOURS=12

# Login rate limiting: failed attempts allowed per account within the window.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15

# How many proxies in front of the API add the client address to X-Forwarded-For (0-5).
# The API uses the address added by the outermost of them; anything further left in the
# header was sent by the client and is ignored. Typical values:
#   0  local development, or nothing in front of the API (the header is ignored)
#   1  browser -> Render -> API (people call the onrender.com URL directly)
#   2  browser -> Vercel (frontend proxy) -> Render -> API
# The right value depends on your proxy chain. After deploying, sign in and check that
# Admin -> Activity log shows your own public IP address.
TRUSTED_PROXY_COUNT=0

# DOCS_ENABLED=true
# LOG_LEVEL=INFO

# Used by the test suite only. The database name must end with "_test".
TEST_DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5432/portfolio_test
